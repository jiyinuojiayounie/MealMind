# Proposed names. Replace placeholders in local runtime configuration as needed.
# Frontend values are browser-visible.
VITE_API_BASE_URL=https://api.example.invalid
VITE_SUPABASE_URL=https://project.example.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-public-key

# Backend only. Keep these out of the frontend environment.
SUPABASE_URL=https://project.example.invalid
SUPABASE_PUBLISHABLE_KEY=replace-with-public-key
GEMINI_API_KEY=replace-with-server-side-key
