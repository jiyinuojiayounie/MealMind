# Copy only the settings you need into the corresponding local file.
# frontend/.env.local (Vite variables are browser-visible)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_CATALOG_PLANNING_PREVIEW=false

# backend/.env
MEALMIND_SERVICE_NAME=mealmind-api
MEALMIND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Optional local catalog planning. Keep draft access disabled on deployed servers.
MEALMIND_ENVIRONMENT=production
MEALMIND_CATALOG_PLANNING_ENABLED=false
MEALMIND_CATALOG_USE_DRAFTS=false
MEALMIND_CATALOG_PERSONALIZATION=false

# Gemini Developer API (backend/.env only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Reserved frontend settings for future Supabase integration
VITE_SUPABASE_URL=https://project.example.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-public-key

# Reserved backend settings for future integrations. Keep these server-side.
SUPABASE_URL=https://project.example.invalid
SUPABASE_PUBLISHABLE_KEY=replace-with-public-key

# Public AI planning is opt-in on both the frontend and the standalone API.
VITE_PUBLIC_PLANNING_ENABLED=false
# VITE_PUBLIC_PLANNING_API_ORIGIN=https://your-planner.onrender.com
MEALMIND_PUBLIC_PLANNING_ENABLED=false
# Free Render hosting requires Redis. The SQLite path is for local tests only.
# MEALMIND_PUBLIC_QUOTA_BACKEND=redis
# MEALMIND_PUBLIC_REDIS_URL=https://your-region-instance.upstash.io
# MEALMIND_PUBLIC_REDIS_TOKEN=configure-on-server-only
# MEALMIND_PUBLIC_QUOTA_PATH=/path/to/local/planning-quota.sqlite3
# Required on Render before activation. Set at or below the verified project limits.
# MEALMIND_PUBLIC_QUOTA_MINUTE=5
# MEALMIND_PUBLIC_QUOTA_DAY=30
# MEALMIND_PUBLIC_QUOTA_MONTH=500
